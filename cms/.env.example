# Firebase Web App configuration. These values identify the Firebase project;
# they are not editor passwords or Firebase Admin credentials.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id

# Comma-separated Firebase Authentication UIDs approved for the editor UI.
# This client-side list is not a substitute for Firestore Security Rules.
VITE_FIREBASE_EDITOR_UIDS=replace-with-approved-editor-uid
