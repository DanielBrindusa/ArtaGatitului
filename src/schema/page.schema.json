{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artagatitului.local/schema/page.schema.json",
  "title": "Arta Gătitului Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pageType", "title", "slug", "description", "status", "layout"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" },
    "pageType": { "enum": ["home", "standard", "landing"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 320 },
    "socialImage": { "type": ["string", "null"] },
    "status": { "enum": ["published", "draft", "archived"] },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelVersion", "blocks"],
      "properties": {
        "modelVersion": { "const": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "block.schema.json" }
        }
      }
    }
  }
}
