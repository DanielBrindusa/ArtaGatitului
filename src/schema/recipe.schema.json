{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artagatitului.local/schema/recipe.schema.json",
  "title": "Arta Gătitului Recipe",
  "type": "object",
  "required": ["slug", "title", "category", "ingredients", "steps", "status"],
  "properties": {
    "id": { "type": "string" },
    "slug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "category": { "type": "string", "minLength": 1 },
    "ingredients": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "beforeStart": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "equipment": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prepTimeMinutes": { "type": ["integer", "null"], "minimum": 0 },
    "cookTimeMinutes": { "type": ["integer", "null"], "minimum": 0 },
    "totalTimeMinutes": { "type": ["integer", "null"], "minimum": 0 },
    "servings": { "type": ["integer", "string", "null"] },
    "image": { "type": ["string", "null"] },
    "sourceUrl": { "type": ["string", "null"] },
    "createdAt": { "type": ["string", "null"] },
    "updatedAt": { "type": ["string", "null"] },
    "closing": { "type": ["string", "null"] },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "ratingSummary": {
      "type": ["object", "null"],
      "properties": {
        "totalRatings": { "type": "integer", "minimum": 0 },
        "overallAverage": { "type": "number", "minimum": 0, "maximum": 5 },
        "tasteAverage": { "type": "number", "minimum": 0, "maximum": 5 },
        "clarityAverage": { "type": "number", "minimum": 0, "maximum": 5 },
        "complexityAverage": { "type": "number", "minimum": 0, "maximum": 5 },
        "cookAgainPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["published", "draft", "archived"]
    }
  },
  "additionalProperties": true
}
