rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedEditor() {
      return request.auth != null
        && request.auth.uid in [
          "6dCliIG9D0UGDDYKo9kFQmMbL1M2"
        ];
    }

    function validNullableString(value) {
      return value == null || value is string;
    }

    function validRecipeDraftContent(data) {
      return data is map
        && data.keys().hasOnly(['modelVersion', 'recipe', 'attachments'])
        && data.modelVersion == 1
        && data.recipe is map
        && data.recipe.keys().hasOnly([
          'id', 'slug', 'title', 'name', 'description', 'category', 'ingredients',
          'steps', 'preparation', 'beforeStart', 'tags', 'equipment',
          'prepTimeMinutes', 'cookTimeMinutes', 'totalTimeMinutes', 'servings',
          'image', 'sourceUrl', 'createdAt', 'updatedAt', 'status', 'closing',
          'imageAlt', 'extras', 'ratingSummary', 'keywords', 'template'
        ])
        && data.recipe.id is string
        && data.recipe.title is string
        && data.recipe.name is string
        && data.recipe.slug is string
        && data.recipe.description is string
        && data.recipe.category is string
        && data.recipe.ingredients is list
        && data.recipe.steps is list
        && data.recipe.preparation is list
        && data.recipe.steps == data.recipe.preparation
        && data.recipe.beforeStart is list
        && data.recipe.equipment is list
        && (data.recipe.prepTimeMinutes == null
          || (data.recipe.prepTimeMinutes is int && data.recipe.prepTimeMinutes >= 0))
        && (data.recipe.cookTimeMinutes == null
          || (data.recipe.cookTimeMinutes is int && data.recipe.cookTimeMinutes >= 0))
        && (data.recipe.totalTimeMinutes == null
          || (data.recipe.totalTimeMinutes is int && data.recipe.totalTimeMinutes >= 0))
        && (data.recipe.servings == null || data.recipe.servings is string
          || (data.recipe.servings is int && data.recipe.servings >= 0))
        && data.recipe.tags is map
        && (data.recipe.image == null || data.recipe.image is string)
        && (data.recipe.imageAlt == null
          || (data.recipe.imageAlt is string && data.recipe.imageAlt.size() <= 500))
        && (data.recipe.sourceUrl == null || data.recipe.sourceUrl is string)
        && (data.recipe.createdAt == null || data.recipe.createdAt is string)
        && (data.recipe.updatedAt == null || data.recipe.updatedAt is string)
        && data.recipe.status in ['published', 'draft', 'archived']
        && data.recipe.closing is string
        && data.recipe.extras is list
        && (data.recipe.ratingSummary == null || data.recipe.ratingSummary is map)
        && data.recipe.keywords is list
        && data.attachments is list
        && data.attachments.size() <= 50;
    }

    function validPageDraftContent(data) {
      return data is map
        && data.keys().hasOnly(['modelVersion', 'page', 'attachments'])
        && data.modelVersion == 1
        && data.page is map
        && data.page.keys().hasOnly([
          'id', 'pageType', 'title', 'slug', 'description', 'socialImage', 'status', 'template'
        ])
        && data.page.id is string
        && data.page.pageType in ['home', 'standard', 'landing']
        && data.page.title is string
        && data.page.slug is string
        && data.page.description is string
        && data.page.description.size() <= 320
        && (data.page.socialImage == null || data.page.socialImage is string)
        && data.page.status in ['published', 'draft', 'archived']
        && data.attachments is list
        && data.attachments.size() <= 50;
    }

    function validSiteDraftContent(data) {
      return data is map
        && data.keys().hasOnly(['modelVersion', 'site', 'sources'])
        && data.modelVersion == 1
        && data.site is map
        && data.site.keys().hasOnly([
          'templates', 'globalBlocks', 'navigation', 'settings', 'theme',
          'categories', 'tagGroups', 'recipes', 'pages'
        ])
        && data.site.templates is map
        && data.site.globalBlocks is map
        && data.site.navigation is map
        && data.site.settings is map
        && data.site.theme is map
        && data.site.categories is list
        && data.site.tagGroups is map
        && data.site.recipes is list
        && data.site.pages is list
        && data.sources is list
        && data.sources.size() <= 100;
    }

    function validDraftLayout(layout) {
      return layout is map
        && layout.keys().hasOnly(['modelVersion', 'blocks'])
        && layout.modelVersion == 1
        && layout.blocks is list;
    }

    function validSourceLink(link, contentType) {
      return link == null || (
        link is map
        && link.keys().hasOnly(['path', 'slug', 'commitSha', 'blobSha', 'sourceJson'])
        && link.path is string
        && link.slug is string
        && link.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && ((contentType == 'recipe'
            && link.path == 'src/content/recipes/' + link.slug + '.json')
          || (contentType == 'page'
            && link.path == 'src/content/pages/' + link.slug + '.json'))
        && link.commitSha is string
        && link.commitSha.matches('^[0-9a-f]{40}$')
        && link.blobSha is string
        && link.blobSha.matches('^[0-9a-f]{40}$')
        && link.sourceJson is string
        && link.sourceJson.size() > 0
      );
    }

    function hasNoPublication(draft) {
      return draft.publishedCommitSha == null
        && draft.publishedRepository == null
        && draft.publishedBranch == null
        && draft.publishedSourceDraftId == null
        && draft.publishedSlug == null
        && draft.publishedAt == null;
    }

    function hasCompletePublication(draft, draftId) {
      return draft.publishedCommitSha is string
        && draft.publishedCommitSha.matches('^[0-9a-f]{40}$')
        && draft.publishedRepository == 'DanielBrindusa/ArtaGatitului'
        && draft.publishedBranch == 'main'
        && draft.publishedSourceDraftId == draftId
        && draft.publishedSlug is string
        && draft.publishedSlug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && draft.publishedAt is timestamp;
    }

    function validDraftDocument(draft, draftId) {
      return draft.keys().hasOnly([
          'id', 'contentType', 'schemaVersion', 'title', 'slug', 'status',
          'data', 'layout', 'createdAt', 'updatedAt', 'updatedByUid',
          'revision', 'publishedCommitSha', 'publishedRepository',
          'publishedBranch', 'publishedSourceDraftId', 'publishedSlug', 'publishedAt',
          'sourceLink', 'deletedAt'
        ])
        && draft.id == draftId
        && draft.contentType in ['recipe', 'page', 'site']
        && draft.schemaVersion == 1
        && draft.title is string
        && draft.title.size() <= 200
        && draft.slug is string
        && draft.slug.size() <= 160
        && draft.status in ['draft', 'ready', 'published', 'publishedDeleted']
        && ((draft.contentType == 'recipe'
            && validRecipeDraftContent(draft.data)
            && draft.data.recipe.id == draft.id
            && draft.data.recipe.title == draft.title
            && draft.data.recipe.name == draft.title
            && draft.data.recipe.slug == draft.slug
            && ((draft.status == 'published' && draft.data.recipe.status == 'published')
              || (draft.status in ['draft', 'ready'] && draft.data.recipe.status == 'draft')
              || (draft.status == 'publishedDeleted' && draft.data.recipe.status == 'archived')))
          || (draft.contentType == 'page'
            && validPageDraftContent(draft.data)
            && draft.data.page.title == draft.title
            && draft.data.page.slug == draft.slug
            && (draft.data.page.pageType != 'home'
              || (draft.data.page.id == 'home' && draft.slug == 'home'))
            && ((draft.status == 'published' && draft.data.page.status == 'published')
              || (draft.status in ['draft', 'ready'] && draft.data.page.status == 'draft')
              || (draft.status == 'publishedDeleted' && draft.data.page.status == 'archived')))
          || (draft.contentType == 'site'
            && validSiteDraftContent(draft.data)
            && draft.slug == 'site-management'
            && draft.status in ['draft', 'ready', 'published']
            && draft.sourceLink == null
            && draft.deletedAt == null
            && draft.layout.blocks.size() == 0))
        && validDraftLayout(draft.layout)
        && draft.createdAt is timestamp
        && draft.updatedAt is timestamp
        && draft.updatedAt == request.time
        && draft.updatedByUid == request.auth.uid
        && draft.revision is int
        && draft.revision > 0
        && validNullableString(draft.publishedCommitSha)
        && validNullableString(draft.publishedRepository)
        && validNullableString(draft.publishedBranch)
        && validNullableString(draft.publishedSourceDraftId)
        && validNullableString(draft.publishedSlug)
        && (draft.publishedAt == null || draft.publishedAt is timestamp)
        && validSourceLink(draft.sourceLink, draft.contentType)
        && (draft.deletedAt == null || draft.deletedAt is timestamp)
        && (hasNoPublication(draft) || hasCompletePublication(draft, draftId))
        && (draft.status != 'published' || draft.sourceLink != null || hasCompletePublication(draft, draftId))
        && (draft.status != 'publishedDeleted'
          || (draft.sourceLink != null && draft.deletedAt is timestamp))
        && (draft.status == 'publishedDeleted' || draft.deletedAt == null)
        && (draft.sourceLink != null || hasNoPublication(draft) || draft.status == 'published');
    }

    function validWorkspaceSetting(setting) {
      return setting.keys().hasOnly(['schemaVersion', 'value', 'updatedAt', 'updatedByUid'])
        && setting.schemaVersion == 1
        && setting.value is map
        && setting.updatedAt is timestamp
        && setting.updatedAt == request.time
        && setting.updatedByUid == request.auth.uid;
    }

    function validPreference(preference) {
      return preference.keys().hasOnly([
          'schemaVersion', 'lastOpenedDraftId', 'previewBreakpoint',
          'updatedAt', 'updatedByUid'
        ])
        && preference.schemaVersion == 1
        && validNullableString(preference.lastOpenedDraftId)
        && preference.previewBreakpoint in ['desktop', 'tablet', 'mobile']
        && preference.updatedAt is timestamp
        && preference.updatedAt == request.time
        && preference.updatedByUid == request.auth.uid;
    }

    function validPublicationAudit(audit, userId, commitSha) {
      return audit.keys().hasOnly([
          'operation', 'contentType', 'contentId', 'draftId', 'editorUid',
          'previousCommitSha', 'newCommitSha', 'deploymentStatus', 'timestamp', 'updatedAt'
        ])
        && audit.operation in ['create', 'update', 'delete', 'restore']
        && audit.contentType in ['recipe', 'page', 'site']
        && audit.contentId is string
        && audit.contentId.size() <= 160
        && audit.draftId is string
        && audit.draftId.size() <= 80
        && audit.editorUid == userId
        && (audit.previousCommitSha == null
          || audit.previousCommitSha.matches('^[0-9a-f]{40}$'))
        && audit.newCommitSha == commitSha
        && audit.newCommitSha.matches('^[0-9a-f]{40}$')
        && audit.deploymentStatus in ['committed', 'building', 'live', 'buildFailed', 'unknown']
        && audit.timestamp is timestamp
        && (!audit.keys().hasAny(['updatedAt']) || audit.updatedAt is timestamp);
    }

    match /workspaces/arta-gatitului/drafts/{draftId} {
      allow read: if isApprovedEditor();
      allow create: if isApprovedEditor()
        && validDraftDocument(request.resource.data, draftId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.revision == 1;
      allow update: if isApprovedEditor()
        && validDraftDocument(request.resource.data, draftId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isApprovedEditor();
    }

    match /workspaces/arta-gatitului/settings/{settingId} {
      allow read: if isApprovedEditor();
      allow create, update: if isApprovedEditor() && validWorkspaceSetting(request.resource.data);
      allow delete: if isApprovedEditor();
    }

    match /users/{userId}/preferences/{preferenceId} {
      allow read: if isApprovedEditor() && request.auth.uid == userId;
      allow create, update: if isApprovedEditor()
        && request.auth.uid == userId
        && validPreference(request.resource.data);
      allow delete: if isApprovedEditor() && request.auth.uid == userId;
    }

    match /users/{userId}/publicationAudit/{commitSha} {
      allow read: if isApprovedEditor() && request.auth.uid == userId;
      allow create: if isApprovedEditor()
        && request.auth.uid == userId
        && validPublicationAudit(request.resource.data, userId, commitSha)
        && request.resource.data.timestamp == request.time;
      allow update: if isApprovedEditor()
        && request.auth.uid == userId
        && validPublicationAudit(request.resource.data, userId, commitSha)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deploymentStatus', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
